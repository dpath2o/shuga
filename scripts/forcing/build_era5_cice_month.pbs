#!/bin/bash
#PBS -N regrid-ERA5-xesmf
#PBS -P jk72
#PBS -q normal
#PBS -l ncpus=16
#PBS -l mem=190GB
#PBS -l jobfs=1GB
#PBS -l walltime=2:00:00
#PBS -l storage=gdata/gv90+gdata/rt52+scratch/gv90+gdata/xp65
#PBS -j oe
#PBS -M daniel.atwater@utas.edu.au
#PBS -m abe

set -euo pipefail

module purge
module use /g/data/xp65/public/modules
module load conda/analysis3-26.02

cd /home/581/da1339/AFIM/src/mawsons-chest/shuga/scripts/forcing

YEAR="${YEAR:?YEAR not set}"
MONTH="${MONTH:?MONTH not set}"
OVERWRITE="${OVERWRITE:-0}"
REGRID_METHOD="${REGRID_METHOD:-bilinear}"
EXTRAP_METHOD="${EXTRAP_METHOD:-nearest_s2d}"
REBUILD_WEIGHTS="${REBUILD_WEIGHTS:-0}"
CICE_GRID_FILE="${CICE_GRID_FILE:-}"
SKIP_COMPRESS="${SKIP_COMPRESS:-0}"
WEIGHT_FILE="${WEIGHT_FILE:-}"
LOG_DIR="${LOG_DIR:-/home/581/da1339/logs/forcing}"
LOG_FILE="${LOG_FILE:-${LOG_DIR}/build_era5_cice_month_${YEAR}_${MONTH}.${PBS_JOBID:-nojobid}.log}"
mkdir -p "${LOG_DIR}"
PBS_STDOUT_LOG="${LOG_DIR}/pbs_regrid_era5_${YEAR}_${MONTH}.${PBS_JOBID:-nojobid}.log"
exec > >(tee -a "${PBS_STDOUT_LOG}") 2>&1

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# Keep temporary/spill files off /home and preferably on node-local jobfs.
export TMPDIR="${PBS_JOBFS:-/tmp}"
export DASK_TEMPORARY_DIRECTORY="${PBS_JOBFS:-/tmp}"

echo "============================================================"
echo "ERA5 -> CICE monthly forcing regrid"
echo "Host        : $(hostname)"
echo "Date        : $(date)"
echo "PBS job id  : ${PBS_JOBID:-unknown}"
echo "Project     : ${PROJECT:-jk72}"
echo "Queue       : ${PBS_QUEUE:-normal}"
echo "NCPUS       : ${PBS_NCPUS:-16}"
echo "MEM         : 130GB"
echo "JOBFS       : ${PBS_JOBFS:-unset}"
echo "YEAR        : ${YEAR}"
echo "MONTH       : ${MONTH}"
echo "OVERWRITE   : ${OVERWRITE}"
echo "LOG_FILE    : ${LOG_FILE}"
echo "ReG_METHOD  : ${REGRID_METHOD}"
echo "Ext_METHOD  : ${EXTRAP_METHOD}"
echo "GRD_FILE    : ${CICE_GRID_FILE:-shuga.core.paths default}"
echo "WEIGHT_FILE : ${WEIGHT_FILE:-auto-derived}"
echo "TMPDIR      : ${TMPDIR}"
echo "============================================================"

args=(--year "${YEAR}"
      --month "${MONTH}"
      --log-level INFO
      --log-file "${LOG_FILE}"
      --regrid-method "${REGRID_METHOD}"
      --extrap-method "${EXTRAP_METHOD}")

if [[ "${OVERWRITE}" == "1" ]]; then
  args+=(--overwrite)
fi

if [[ -n "${CICE_GRID_FILE}" ]]; then
    args+=(--cice-grid-file "${CICE_GRID_FILE}")
fi

if [[ -n "${WEIGHT_FILE}" ]]; then
    args+=(--weight-file "${WEIGHT_FILE}")
fi

if [[ "${REBUILD_WEIGHTS}" == "1" ]]; then
    args+=(--rebuild-weights)
fi

PYOUT="$(python ./build_era5_cice_month.py "${args[@]}")"
echo "${PYOUT}"

FILE="$(printf "%s\n" "${PYOUT}" | tail -n 1)"

echo "completed python regrid and monthly building of forcing file: $(date)"
echo "Output file : ${FILE}"

[[ -n "${FILE}" ]] || { echo "ERROR: python script returned no output path" >&2; exit 1; }

###########################################################
# rewrite ERA5 monthly file into CICE-runtime layout
###########################################################
if [[ "${SKIP_COMPRESS}" == "1" ]]; then
    echo "SKIP_COMPRESS=1; leaving file as written by python: ${FILE}"
    exit 0
fi

echo "using nccopy to rewrite ERA5 -> CICE monthly forcing file"

# nccopy is usually available in analysis3, but keep this if needed.
module load nco || true

# ------------------------------------------------------------------
# Runtime-layout defaults
#
# Default is CICE-fast:
#   - NetCDF-4 classic model
#   - no compression
#   - convert unlimited time to fixed-size
#   - no explicit chunking, so NetCDF/HDF5 can use a more contiguous layout
#
# If you explicitly want compressed runtime files:
#   NCCOPY_PROFILE=compressed
# uses:
#   -d ${DEFLATE}
#   -s
#   -c time/1,ny/108,nx/144
#
# Avoid time/24 for CICE runtime because CICE reads one 2-D hourly
# record at a time.
# ------------------------------------------------------------------
NCCOPY_PROFILE="${NCCOPY_PROFILE:-runtime}"   # runtime | compressed | none
DEFLATE="${DEFLATE:-1}"
CHUNKSPEC="${CHUNKSPEC:-time/1,ny/108,nx/144}"
KEEP_RAW="${KEEP_RAW:-0}"

indir="$(dirname "${FILE}")"
base="$(basename "${FILE}" .nc)"

raw="${indir}/${base}.raw.nc"
tmp="${indir}/.${base}.nccopy.tmp.nc"

echo "============================================================"
echo "Rewrite ERA5 -> CICE monthly forcing"
echo "Date          : $(date)"
echo "Host          : $(hostname)"
echo "Job ID        : ${PBS_JOBID:-unknown}"
echo "Input         : ${FILE}"
echo "Raw backup    : ${raw}"
echo "Temp          : ${tmp}"
echo "Profile       : ${NCCOPY_PROFILE}"
echo "Deflate       : ${DEFLATE}"
echo "Chunkspec     : ${CHUNKSPEC}"
echo "Keep raw      : ${KEEP_RAW}"
echo "============================================================"

[[ -f "${FILE}" ]] || { echo "Input file not found: ${FILE}" >&2; exit 1; }

rm -f "${tmp}"

echo "Input size/layout:"
ls -lh "${FILE}"
ncdump -k "${FILE}" || true
ncdump -h "${FILE}" | sed -n '/dimensions:/,/variables:/p' | head -30

case "${NCCOPY_PROFILE}" in

    runtime)
        echo "Running CICE-fast nccopy:"
        echo "  nccopy -k nc7 -d 0 -u ${FILE} ${tmp}"

        nccopy -k nc7 -d 0 -u "${FILE}" "${tmp}"
        ;;

    compressed)
        echo "Running compressed CICE-runtime nccopy:"
        echo "  nccopy -k nc7 -d ${DEFLATE} -s -c ${CHUNKSPEC} -u ${FILE} ${tmp}"

        nccopy -k nc7 -d "${DEFLATE}" -s -c "${CHUNKSPEC}" -u "${FILE}" "${tmp}"
        ;;

    none)
        echo "NCCOPY_PROFILE=none; leaving file unchanged."
        exit 0
        ;;

    *)
        echo "ERROR: unknown NCCOPY_PROFILE=${NCCOPY_PROFILE}" >&2
        echo "Valid options: runtime, compressed, none" >&2
        exit 1
        ;;
esac

echo "Checking rewritten temporary file..."
[[ -s "${tmp}" ]] || { echo "ERROR: nccopy output missing/empty: ${tmp}" >&2; exit 1; }

ncdump -k "${tmp}" || true

header="${tmp}.header.txt"
ncdump -h -s "${tmp}" > "${header}"

echo "Temporary file header:"
head -100 "${header}"
rm -f "${header}"

echo "Temporary size:"
ls -lh "${tmp}"

# Replace original only after successful nccopy and header inspection.
if [[ "${KEEP_RAW}" == "1" ]]; then
    mv -f "${FILE}" "${raw}"
    mv -f "${tmp}" "${FILE}"
    echo "Raw file moved to          : ${raw}"
    echo "Rewritten file installed as: ${FILE}"
else
    mv -f "${tmp}" "${FILE}"
    echo "Rewritten file installed as: ${FILE}"
    echo "No raw copy retained."
fi

echo "Final size/layout:"
ls -lh "${FILE}"
ncdump -k "${FILE}" || true
ncdump -h -s "${FILE}" | egrep "_ChunkSizes|_DeflateLevel|airtmp|snowfall|rainfall|time =" -A4 || true

echo "Finished at $(date)"
