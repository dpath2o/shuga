#!/usr/bin/env bash
#PBS -P jk72
#PBS -q normalbw
#PBS -l walltime=04:00:00
#PBS -l ncpus=8
#PBS -l mem=48GB
#PBS -l storage=gdata/gv90+scratch/gv90+gdata/xp65+gdata/jk72
#PBS -j oe
#PBS -N diff_FIP

set -euo pipefail

cd "${PBS_O_WORKDIR:-$PWD}"

module purge
module use /g/data/xp65/public/modules
module load conda/analysis3-25.12

: "${SIM_NAME:?Set SIM_NAME, e.g. qsub -v SIM_NAME=LD-blend-base FIP_differencing.pbs}"
: "${START_DATE:=2000-01-01}"
: "${END_DATE:=2005-12-31}"
: "${FIP_START:=2000-04-01}"
: "${FIP_END:=2005-12-30}"
: "${CLASSIFICATION:=binary-days}"
: "${GRID_TYPE:=Tc}"
: "${AF2020_STORE:=/g/data/gv90/da1339/SeaIce/FI_obs/AF-FI-2020db_common-5km_pyresample.zarr}"
: "${OVERWRITE:=0}"
: "${PLOT:=1}"

args=(FIP_differencing.py
      --sim-name "${SIM_NAME}"
      --start-date "${START_DATE}"
      --end-date "${END_DATE}"
      --fip-start "${FIP_START}"
      --fip-end "${FIP_END}"
      --classification "${CLASSIFICATION}"
      --grid-type "${GRID_TYPE}"
      --af2020-store "${AF2020_STORE}"
      --pixel-size-m "${PIXEL_SIZE_M:-5000}"
      --radius-of-influence-m "${ROI_M:-10000}"
      --cice-lon-shift-deg "${CICE_LON_SHIFT_DEG:-0.25}")

if [[ "${OVERWRITE}" == "1" ]]; then
  args+=(--overwrite)
fi
if [[ "${PLOT}" == "1" ]]; then
  args+=(--plot)
fi
if [[ "${PLOT_CATEGORICAL:-0}" == "1" ]]; then
  args+=(--plot-categorical)
fi

python "${args[@]}"
