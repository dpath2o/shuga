#!/usr/bin/env bash
#PBS -P jk72
#PBS -q normalbw
#PBS -l walltime=01:00:00
#PBS -l ncpus=2
#PBS -l mem=16GB
#PBS -l jobfs=5GB
#PBS -l storage=gdata/gv90+gdata/xp65
#PBS -l wd
#PBS -j oe
#PBS -N SIA_climatology
set -euo pipefail
module purge
module use /g/data/xp65/public/modules
module load conda/analysis3-25.12
ROOT="/g/data/gv90/da1339"
REPO="${ROOT}/src/mawsons-chest"
MODEL_ROOT="${ROOT}/afim_output/GRAPHICAL/LD-pub-workspace/timeseries"
SEAICE_ROOT="${ROOT}/SeaIce"
NSIDC_STORE="${SEAICE_ROOT}/NSIDC/processed/NSIDC_G02202_V6_SH_SIA_SIE.zarr"
OSISAF_STORE="${SEAICE_ROOT}/OSI-SAF-450/processed/OSI-SAF-450_SH_SIA.zarr"
ORAS_STORE="${SEAICE_ROOT}/CMEMS/CMEMS_SIA_SIV_SIT_2000-2005.zarr"
OUTPUT="${ROOT}/SIA_SH_climatology_2000-2005_with_OSISAF450.png"
cd "${REPO}"
export PYTHONNOUSERSITE=1
export PYTHONPATH="${REPO}"
python -u shuga/scripts/plotting/plot_SIA_climatology.py \
  --model-root "${MODEL_ROOT}" --seaice-root "${SEAICE_ROOT}" \
  --nsidc-store "${NSIDC_STORE}" --osisaf-store "${OSISAF_STORE}" --oras-store "${ORAS_STORE}" \
  --start-date 1994-01-01 --end-date 1999-12-31 --envelope minmax --smooth-days 1 --y-max 18 \
  --output "${OUTPUT}"
