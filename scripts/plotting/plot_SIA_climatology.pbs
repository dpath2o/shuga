#!/usr/bin/env bash
#PBS -P jk72
#PBS -q normalbw
#PBS -l walltime=01:00:00
#PBS -l ncpus=2
#PBS -l mem=16GB
#PBS -l jobfs=5GB
#PBS -l storage=gdata/gv90+gdata/xp65
#PBS -l wd
#PBS -j oe
#PBS -N SIA_climatology

set -euo pipefail

module purge
module use /g/data/xp65/public/modules
module load conda/analysis3-25.12

ROOT="/g/data/gv90/da1339"
REPO="${ROOT}/src/mawsons-chest"
SEAICE_ROOT="${ROOT}/SeaIce"

# ------------------------------------------------------------------
# Set these at qsub time for paper1 / paper2 / paper3.
# ------------------------------------------------------------------
PAPER_ROOT="${PAPER_ROOT:?PAPER_ROOT not set}"
START_DATE="${START_DATE:?START_DATE not set}"
END_DATE="${END_DATE:?END_DATE not set}"
OUTPUT="${OUTPUT:?OUTPUT not set}"

# Comma-separated SIM=LABEL list.
EXPERIMENTS="${EXPERIMENTS:-}"

NSIDC_STORE="${NSIDC_STORE:-${SEAICE_ROOT}/NSIDC/processed/NSIDC_G02202_V6_SH_SIA_SIE.zarr}"
OSISAF_STORE="${OSISAF_STORE:-${SEAICE_ROOT}/OSI-SAF-450/processed/OSI-SAF-450_SH_SIA.zarr}"
CMEMS_STORE="${CMEMS_STORE:-${SEAICE_ROOT}/CMEMS/0p083/daily/SH/SI/mets.zarr}"

ENVELOPE="${ENVELOPE:-minmax}"
SMOOTH_DAYS="${SMOOTH_DAYS:-1}"
Y_MAX="${Y_MAX:-18}"

cd "${REPO}"

export PYTHONNOUSERSITE=1
export PYTHONPATH="${REPO}"

CMD=(
  python -u shuga/scripts/plotting/plot_SIA_climatology.py
  --paper-root "${PAPER_ROOT}"
  --seaice-root "${SEAICE_ROOT}"
  --nsidc-store "${NSIDC_STORE}"
  --osisaf-store "${OSISAF_STORE}"
  --cmems-store "${CMEMS_STORE}"
  --start-date "${START_DATE}"
  --end-date "${END_DATE}"
  --envelope "${ENVELOPE}"
  --smooth-days "${SMOOTH_DAYS}"
  --y-max "${Y_MAX}"
  --output "${OUTPUT}"
)

[[ -n "${EXPERIMENTS}" ]] && CMD+=(--experiments "${EXPERIMENTS}")

echo "Running: ${CMD[*]}"
"${CMD[@]}"
