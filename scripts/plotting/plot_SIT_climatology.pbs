#!/bin/bash
#PBS -P jk72
#PBS -q normalbw
#PBS -l walltime=01:00:00
#PBS -l ncpus=2
#PBS -l mem=16GB
#PBS -l jobfs=5GB
#PBS -l storage=gdata/gv90+gdata/xp65
#PBS -l wd
#PBS -j oe
#PBS -N SIT_climatology
set -euo pipefail
module purge
module use /g/data/xp65/public/modules
module load conda/analysis3-26.02

ROOT="/g/data/gv90/da1339"
REPO="${ROOT}/src/mawsons-chest"
DATA_ROOT="${DATA_ROOT:-${ROOT}/afim_output}"
MODEL_START_DATE="${MODEL_START_DATE:-2000-01-01}"
MODEL_END_DATE="${MODEL_END_DATE:-2005-12-31}"
HEMISPHERE="${HEMISPHERE:-SH}"
EXPERIMENTS="${EXPERIMENTS:-no-slip-LFI=LFI rheology without lateral drag,Cs-high=static high Cs,Cq-high=quadratic high Cq}"
ESA_STORE="${ESA_STORE:-${ROOT}/SeaIce/SIT/processed/${HEMISPHERE}/ESA/SIT_timeseries.zarr}"
AWI_STORE="${AWI_STORE:-${ROOT}/SeaIce/SIT/processed/${HEMISPHERE}/AWI/SIT_timeseries.zarr}"
CMEMS_STORE="${CMEMS_STORE:-${ROOT}/SeaIce/CMEMS/0p083/daily/${HEMISPHERE}/SI/mets.zarr}"
OUTPUT="${OUTPUT:-${ROOT}/GRAPHICAL/LD-pub-workspace/timeseries/SIT_${HEMISPHERE}_climatology_2000-2005.png}"

cd "$REPO"
export PYTHONPATH="$REPO"
export PYTHONNOUSERSITE=1

CMD=(python -u shuga/scripts/plotting/plot_SIT_climatology.py
     --data-root "$DATA_ROOT"
     --model-start-date "$MODEL_START_DATE"
     --model-end-date "$MODEL_END_DATE"
     --hemisphere "$HEMISPHERE"
     --experiments "$EXPERIMENTS"
     --esa-store "$ESA_STORE"
     --awi-store "$AWI_STORE"
     --cmems-store "$CMEMS_STORE"
     --output "$OUTPUT"
     --envelope "${ENVELOPE:-p10-p90}"
     --y-max "${Y_MAX:-3}")
echo "Running: ${CMD[*]}"
"${CMD[@]}"
