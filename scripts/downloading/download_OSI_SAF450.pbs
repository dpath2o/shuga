#!/usr/bin/env bash
#PBS -P gv90
#PBS -q copyq
#PBS -l walltime=10:00:00
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l storage=gdata/gv90+gdata/xp65
#PBS -l wd
#PBS -j oe
#PBS -N osisaf450_download

set -euo pipefail

module purge
module use /g/data/xp65/public/modules
module load conda/analysis3

: "${START_DATE:?Set START_DATE=YYYY-MM-DD}"
: "${END_DATE:?Set END_DATE=YYYY-MM-DD}"

: "${RAW_DIR:=/g/data/gv90/da1339/SeaIce/OSI-SAF-450/raw}"
: "${DATASET_ID:=OSISAF-GLO-SEAICE_CONC_TIMESERIES-SH-LA-OBS}"
: "${OVERWRITE:=}"
: "${SHUGA_ROOT:=/g/data/gv90/da1339/src/mawsons-chest}"
: "${OSISAF_VENV:=/g/data/gv90/da1339/venvs/osisaf450}"

export PYTHONNOUSERSITE=1

source "${OSISAF_VENV}/bin/activate"

cd "${SHUGA_ROOT}"
export PYTHONPATH="${SHUGA_ROOT}:${PYTHONPATH:-}"

# processed-dir is not used during a download-only invocation, but the
# current CLI still declares it as required.
UNUSED_PROCESSED_DIR="${RAW_DIR}/.unused_processed"

CMD=(
    python -u
    -m shuga.observations.OSI_SAF450
    --raw-dir "${RAW_DIR}"
    --processed-dir "${UNUSED_PROCESSED_DIR}"
    --start-date "${START_DATE}"
    --end-date "${END_DATE}"
    --dataset-id "${DATASET_ID}"
    --hemisphere SH
    --download
)

if [[ -n "${OVERWRITE}" ]]; then
    CMD+=(--overwrite)
fi

printf 'Running:'
printf ' %q' "${CMD[@]}"
printf '\n'

"${CMD[@]}"
