#!/bin/bash
#PBS -P gv90
#PBS -q copyq
#PBS -l walltime=01:00:00
#PBS -l ncpus=1
#PBS -l mem=2GB
#PBS -l jobfs=2GB
#PBS -l storage=gdata/gv90+gdata/xp65
#PBS -j oe
#PBS -N test_AFIAC_real

set -euo pipefail

module purge
module use /g/data/xp65/public/modules
module load conda/analysis3-26.08

REPO="${REPO:-$HOME/src/shuga}"
ROOT="${ROOT:-/g/data/gv90/da1339/SeaIce/InSitu/raw}"

cd "$REPO"

export PYTHONPATH="$(dirname -- "$PWD")"
export PYTHONNOUSERSITE=1

python -u scripts/downloading/download_insitu_thickness.py \
    --root "$ROOT" \
    --sources afiac \
    --log-level INFO
