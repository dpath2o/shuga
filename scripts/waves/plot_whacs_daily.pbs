#!/bin/bash
#PBS -P au88
#PBS -q normalbw
#PBS -l ncpus=4
#PBS -l mem=48GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/gv90+gdata/ia39+gdata/xp65
#PBS -l wd
#PBS -j oe
#PBS -r y
#PBS -N shuga_whacs_plot

set -euo pipefail

START_YEAR="${START_YEAR:-1995}"
END_YEAR="${END_YEAR:-2005}"
ARRAY_INDEX="${PBS_ARRAY_INDEX:-0}"

TOTAL_MONTHS=$(( (END_YEAR - START_YEAR + 1) * 12 ))
if (( ARRAY_INDEX < 0 || ARRAY_INDEX >= TOTAL_MONTHS )); then
    echo "PBS_ARRAY_INDEX=${ARRAY_INDEX} outside 0..$((TOTAL_MONTHS - 1))" >&2
    exit 2
fi

YEAR=$(( START_YEAR + ARRAY_INDEX / 12 ))
MONTH_NUM=$(( ARRAY_INDEX % 12 + 1 ))
MONTH="$(printf '%02d' "${MONTH_NUM}")"

DATA_PROJECT="${DATA_PROJECT:-gv90}"
RUN_USER="${RUN_USER:-da1339}"
SIM_NAME="${SIM_NAME:-LD-waves-exp01}"
WHACS_ROOT="${WHACS_ROOT:-/g/data/ia39/WP3/release/ACS_hindcast/spec/release/WP3/WHACS/BoM-CSIRO/hindcast/ERA5/ERA5/WHACS/WWIII-v6.07/spectra/1hr/efth}"
REGRID_ROOT="${REGRID_ROOT:-/g/data/${DATA_PROJECT}/${RUN_USER}/afim_input/CAWCR}"
OUTPUT_ROOT="${OUTPUT_ROOT:-/g/data/${DATA_PROJECT}/${RUN_USER}/GRAPHICAL/LD-waves/WHACS/daily}"
NORTH="${NORTH:--35.0}"
GRID_STRIDE="${GRID_STRIDE:-3}"
HS_MAX="${HS_MAX:-}"
TP_MAX="${TP_MAX:-}"
DPI="${DPI:-300}"
OVERWRITE="${OVERWRITE:-false}"

SCRIPT_ROOT="${SCRIPT_ROOT:-/home/581/da1339/AFIM/src/mawsons-chest}"
PY_SCRIPT="${PY_SCRIPT:-${SCRIPT_ROOT}/shuga/scripts/waves/plot_whacs_daily.py}"

module use /g/data/xp65/public/modules
module load conda/analysis3-26.01

export PYTHONUNBUFFERED=1
export PYTHONPATH="${SCRIPT_ROOT}:${PYTHONPATH:-}"

ARGS=(
    "${YEAR}" "${MONTH}"
    --project "${DATA_PROJECT}"
    --user "${RUN_USER}"
    --sim-name "${SIM_NAME}"
    --source-root "${WHACS_ROOT}"
    --regridded-root "${REGRID_ROOT}"
    --output-root "${OUTPUT_ROOT}"
    --north "${NORTH}"
    --grid-stride "${GRID_STRIDE}"
    --dpi "${DPI}"
)

[[ -n "${HS_MAX}" ]] && ARGS+=(--hs-max "${HS_MAX}")
[[ -n "${TP_MAX}" ]] && ARGS+=(--tp-max "${TP_MAX}")
[[ "${OVERWRITE}" == "true" ]] && ARGS+=(--overwrite)

python "${PY_SCRIPT}" "${ARGS[@]}"
