#!/usr/bin/env bash
#PBS -P gv90
#PBS -q normalbw
#PBS -l walltime=06:00:00
#PBS -l ncpus=4
#PBS -l mem=64GB
#PBS -l jobfs=20GB
#PBS -l storage=gdata/gv90+gdata/xp65
#PBS -l wd
#PBS -j oe
#PBS -N osisaf450_process

set -euo pipefail

module purge
module use /g/data/xp65/public/modules
module load conda/analysis3

: "${START_DATE:?Set START_DATE=YYYY-MM-DD}"
: "${END_DATE:?Set END_DATE=YYYY-MM-DD}"

: "${RAW_DIR:=/g/data/gv90/da1339/SeaIce/OSI-SAF-450/raw}"
: "${PROCESSED_DIR:=/g/data/gv90/da1339/SeaIce/OSI-SAF-450/processed}"
: "${CHUNKS_TIME:=8}"
: "${OVERWRITE:=}"
: "${SHUGA_ROOT:=/g/data/gv90/da1339/src/mawsons-chest}"

cd "${SHUGA_ROOT}"
export PYTHONPATH="${SHUGA_ROOT}:${PYTHONPATH:-}"

python - <<'PY'
import shuga.observations.OSI_SAF450 as module

print("Using OSI-SAF module:", module.__file__)
PY

CMD=(
    python -u
    -m shuga.observations.OSI_SAF450
    --raw-dir "${RAW_DIR}"
    --processed-dir "${PROCESSED_DIR}"
    --start-date "${START_DATE}"
    --end-date "${END_DATE}"
    --hemisphere SH
    --chunks-time "${CHUNKS_TIME}"
    --process
)

if [[ -n "${OVERWRITE}" ]]; then
    CMD+=(--overwrite)
fi

printf 'Running:'
printf ' %q' "${CMD[@]}"
printf '\n'

"${CMD[@]}"

