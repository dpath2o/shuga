#!/bin/bash
#PBS -P gv90
#PBS -q normalbw
#PBS -l walltime=00:20:00
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l jobfs=1GB
#PBS -l storage=gdata/gv90+gdata/xp65
#PBS -j oe
#PBS -N test_BEPSII_v2

set -euo pipefail

module purge
module use /g/data/xp65/public/modules
module load conda/analysis3-26.08

REPO="${REPO:-$HOME/src/shuga}"

cd "$REPO"

export PYTHONPATH="$(dirname -- "$PWD")"
export PYTHONNOUSERSITE=1

python -u scripts/observations/insitu_thickness.py \
    --input /g/data/gv90/da1339/SeaIce/InSitu/raw/Zenodo/BEPSII_TS/DATA/BEPSII_TS_v1.0.nc \
    --output-root /g/data/gv90/da1339/SeaIce/InSitu/processed/BEPSII_TS \
    --hemisphere SH \
    --dry-run \
    --log-level INFO
