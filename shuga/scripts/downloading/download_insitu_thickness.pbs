#!/bin/bash
#PBS -P gv90
#PBS -q copyq
#PBS -l walltime=10:00:00
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l jobfs=2GB
#PBS -l storage=gdata/gv90+gdata/xp65
#PBS -j oe
#PBS -N dl_insitu_hi

set -euo pipefail

module purge
module use /g/data/xp65/public/modules
module load conda/analysis3-26.02

REPO="${REPO:-$HOME/AFIM/src/mawsons-chest}"
ROOT="${ROOT:-/g/data/gv90/da1339/SeaIce/InSitu/raw}"
SOURCES="${SOURCES:-afiac,stations,asac2500,davis2015,bepsii}"

cd "$REPO"

export PYTHONPATH="$REPO"
export PYTHONNOUSERSITE=1

CMD=(
    python -u shuga/scripts/downloading/download_insitu_thickness.py
    --root "$ROOT"
    --sources "$SOURCES"
    --retries "${RETRIES:-5}"
    --log-level "${LOG_LEVEL:-INFO}"
)

[[ "${DRY_RUN:-false}" == "true" ]] && CMD+=(--dry-run)
[[ "${OVERWRITE:-false}" == "true" ]] && CMD+=(--overwrite)
[[ "${BEPSII_LOGSHEETS:-false}" == "true" ]] && CMD+=(--include-bepsii-logsheets)

echo "Running: ${CMD[*]}"
"${CMD[@]}"
